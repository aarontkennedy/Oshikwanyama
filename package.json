{
  "name": "oshikwanyama",
  "private": true,
  "version": "1.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "licenses": "node scripts/check-licenses.mjs",
    "icons": "node scripts/make-icons.mjs",
    "deps": "npm outdated; npm audit",
    "check": "tsc && npm run licenses && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@trickfilm400/rollup-plugin-off-main-thread": "4.0.0",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
